# 功能：提供本地配置模板；复制为 .env 后填写，不要提交包含密钥的 .env。
APP_ENV=local
APP_NAME=psychological-service-quality-agent
ENABLE_CROSS_SESSION_MEMORY=false
# Railway: set this to ${{Postgres.DATABASE_URL}} on the application service.
DATABASE_URL=

# Model adapter only; the existing website remains in demo mode.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.5-plus
# Beijing endpoint. Use the matching regional endpoint for your Bailian API key.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=90
QWEN_MAX_TOKENS=4096

# Optional separate local development API; requires a random token (24+ characters).
LOCAL_API_TOKEN=
LOCAL_JOB_DB=data/local/jobs.sqlite3

# Optional directory of authored metric Skill packages; default app/skills/metric_packages.
# METRIC_SKILLS_DIR=app/skills/metric_packages
