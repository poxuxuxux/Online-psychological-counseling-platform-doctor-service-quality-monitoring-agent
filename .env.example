# Railway injects DATABASE_URL from the attached PostgreSQL service.
# Local blank value uses data/local/teams.sqlite3; production requires a PostgreSQL URL.
APP_ENV=local
DATABASE_URL=
# Railway Bucket conversation-files 的五个引用变量，只在后端配置；未配置时保留本地数据库模式。
BUCKET=
ENDPOINT=
REGION=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
# Bucket 中所有对象上传前均使用此 Fernet 密钥加密；妥善备份，丢失后无法解密旧对象。
BUCKET_ENCRYPTION_KEY=
EVALUATION_API_TOKEN=
# 前端另有独立公网域名时填写其精确 Origin，多个以英文逗号分隔；同源部署留空。
FRONTEND_ORIGINS=
SEED_DEMO=true

# Configure one model provider. No scores are fabricated when credentials are absent.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.5-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_TOKENS=4096
GLM_API_KEY=
GLM_MODEL=glm-4-plus
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

METRIC_SKILLS_DIR=app/rubrics/metrics
# 新运行先全18项初评，再Leader三阶段选择/赋权，最后最多三轮反馈。旧协议仅兼容恢复。
TEAM_PROTOCOL=leader-review-v2
# 最终归一化权重相对等权占比的最大浮动；0.2表示±20%，不是±20个百分点。
TEAM_WEIGHT_DEVIATION=0.2
# 新协议的MAX_STEPS约束每个阶段的工具/模型步骤；业务协商上限固定为3轮。
TEAM_MAX_STEPS=24
TEAM_MAX_ROUNDS=40
TEAM_MAX_MESSAGES=60
TEAM_MAX_REVIEWS=6
TEAM_MAX_REVISIONS=2
TEAM_MAX_MODEL_CALLS=180
TEAM_AGENT_TIMEOUT=300
TEAM_MODEL_TIMEOUT=60
TEAM_TOTAL_TIMEOUT=600
