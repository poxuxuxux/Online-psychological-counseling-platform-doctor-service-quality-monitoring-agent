{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xinheng:hook-results:1.0",
  "title": "Risk and disagreement Hook results — design draft",
  "description": "仅为接口设计。授权、证据引用解析、版本一致性、覆盖范围及去重必须由后端另行检查。",
  "oneOf": [
    {
      "$ref": "#/$defs/RiskScanResult"
    },
    {
      "$ref": "#/$defs/ConflictScanResult"
    }
  ],
  "$defs": {
    "RiskSignal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "candidate"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "signal_type": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "context_message_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "target_metric_ids": {
          "type": "array",
          "items": {
            "enum": [
              "D6.1",
              "D6.2"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      },
      "required": [
        "candidate_id",
        "status",
        "rule_id",
        "rule_version",
        "signal_type",
        "evidence_refs",
        "context_message_ids",
        "target_metric_ids"
      ]
    },
    "ConflictCandidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "candidate"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "metric_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "conflict_id",
        "status",
        "rule_id",
        "rule_version",
        "finding_ids",
        "metric_ids",
        "event_refs",
        "claim_refs",
        "evidence_refs",
        "explanation"
      ]
    },
    "UncertainPair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "finding_ids",
        "reason",
        "event_refs"
      ]
    },
    "RiskScanResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "hook_version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "round_id": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "input_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "skipped",
            "failed",
            "not_configured"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "reference_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true
              }
            },
            "required": [
              "code",
              "reference_ids"
            ]
          }
        },
        "hook_name": {
          "const": "risk_monitor"
        },
        "scan_outcome": {
          "enum": [
            "detected",
            "not_detected",
            "uncertain",
            "unavailable"
          ]
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RiskSignal"
          }
        },
        "scanned_message_count": {
          "type": "integer",
          "minimum": 0
        },
        "unscannable_message_count": {
          "type": "integer",
          "minimum": 0
        },
        "uncertainty_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "hook_version",
        "run_id",
        "round_id",
        "source_snapshot_id",
        "input_version",
        "status",
        "issues",
        "hook_name",
        "scan_outcome",
        "signals",
        "scanned_message_count",
        "unscannable_message_count",
        "uncertainty_refs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scan_outcome": {
                "const": "detected"
              }
            },
            "required": [
              "scan_outcome"
            ]
          },
          "then": {
            "properties": {
              "signals": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scan_outcome": {
                "enum": [
                  "not_detected",
                  "unavailable"
                ]
              }
            },
            "required": [
              "scan_outcome"
            ]
          },
          "then": {
            "properties": {
              "signals": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed",
                  "not_configured",
                  "skipped"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "scan_outcome": {
                "const": "unavailable"
              },
              "signals": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "ConflictScanResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "hook_version": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "round_id": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "input_version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "skipped",
            "failed",
            "not_configured"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "reference_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "maxItems": 100,
                "uniqueItems": true
              }
            },
            "required": [
              "code",
              "reference_ids"
            ]
          }
        },
        "hook_name": {
          "const": "disagreement_detector"
        },
        "eligible_finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "compared_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConflictCandidate"
          }
        },
        "uncertain_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UncertainPair"
          }
        },
        "excluded_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "finding_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "finding_id",
              "reason"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "hook_version",
        "run_id",
        "round_id",
        "source_snapshot_id",
        "input_version",
        "status",
        "issues",
        "hook_name",
        "eligible_finding_count",
        "compared_pair_count",
        "conflicts",
        "uncertain_pairs",
        "excluded_findings"
      ]
    }
  }
}
