{
  "name": "xin-heng-quality-console",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "build:backend": "pnpm build && node scripts/sync-backend.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:preview": "pnpm build && node scripts/standalone.mjs",
    "test:preview": "node scripts/check-preview.mjs"
  },
  "dependencies": {
    "vue": "3.5.43",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
